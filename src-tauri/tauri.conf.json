{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "goPanda",
  "version": "1.0.0",
  "identifier": "com.dot.gopanda",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "goPanda - Focus Timer & Productivity Studio",
        "label": "main",
        "width": 180,
        "height": 180,
        "minWidth": 180,
        "minHeight": 180,
        "maxWidth": 180,
        "maxHeight": 180,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "center": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true,
        "noRedirectionBitmap": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.13"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
